{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "document-site",
  "compatibility_date": "2025-06-01",
  "main": "src/worker.ts",

  // 静态文档站:Astro 构建产物 dist/ 由 worker.ts 登录门代理(复用 apiServer 认证),
  // run_worker_first 保证所有请求先过登录门,静态资产经 ASSETS binding 放行。
  // Custom Domain 绑定 doc.banzheshenghuo.com(自动创建 DNS 记录与证书)。
  // 部署:npm run deploy(= build && wrangler deploy)
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "routes": [
    { "pattern": "doc.banzheshenghuo.com", "custom_domain": true }
  ]
}
